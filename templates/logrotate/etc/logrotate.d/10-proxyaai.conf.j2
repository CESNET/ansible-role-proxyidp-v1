{% if components_krb_exchanger == "enabled" %}
# KRB Exchanger
{{ log_path }}/krb_exchanger/krb_exchanger.log
{
        rotate 181
        dateext
        dateformat .%Y-%m-%d
        daily
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
                sleep $(shuf -i5-60 -n1) && docker restart krb-exchanger
                /usr/lib/rsyslog/rsyslog-rotate
        endscript
}
{% endif %}

